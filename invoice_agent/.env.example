# Vertex AI via application default credentials. Never set GOOGLE_API_KEY or
# GOOGLE_GENAI_API_KEY — with Vertex enabled those switch you to Express Mode.
GOOGLE_GENAI_USE_ENTERPRISE=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id

# gemini-3.5-flash is not served from us-central1. Use global.
GOOGLE_CLOUD_LOCATION=global

# Where saved records and archived documents go. Terraform sets both on Cloud
# Run. Leave them unset on a laptop: records then append to
# .local_records.jsonl and documents copy into .local_archive/, with no project
# needed. Setting FIRESTORE_DATABASE is what switches the store to the cloud.
# FIRESTORE_DATABASE=invoices
# INVOICE_BUCKET=invoice-agent-your-project-id
